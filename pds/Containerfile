FROM docker.io/library/node:24-bookworm-slim

ENV NODE_ENV=production PORT=2583 CONFIG_FILE=/etc/mosimo/config.json
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY *.mjs *.mts ./
RUN test -f main.mjs

USER node
EXPOSE 2583

CMD ["node", "main.mjs"]
