default_platform(:android)

ANDROID_APPS = {
  "mosimo" => { module: "app", package: "dev.jisaku.mosimo" }
}.freeze

def android_app!(options)
  ANDROID_APPS.fetch(options[:app].to_s) { UI.user_error!("Unknown app: #{options[:app]}. Choose: #{ANDROID_APPS.keys.join(', ')}") }
end

platform :android do
  desc "Run unit tests, lint, and build a debug APK for the selected app"
  lane :ci do |options|
    m = android_app!(options)[:module]
    gradle(tasks: [":dtn7-bpv7:test", ":bundle-core:test", ":mesh-android:testDebugUnitTest",
                   ":#{m}:testDebugUnitTest", ":#{m}:lintDebug", ":#{m}:assembleDebug"])
  end

  desc "Build a signed release AAB using the Gradle version"
  lane :build do |options|
    gradle(task: ":#{android_app!(options)[:module]}:bundleRelease")
  end

  desc "Test, build, and publish the AAB and screenshots to the Google Play alpha track"
  # Named internal because mise's deploy task calls it.
  lane :internal do |options|
    app = android_app!(options)
    ci(options)
    build(options)
    # ci leaves the debug APK in lane_context; upload only the AAB.
    upload_to_play_store(package_name: app[:package], track: "alpha", skip_upload_apk: true)
  end
end
