default_platform(:android)

# dir is the Gradle root; Hanashi has its own and reuses this one's mesh modules in place.
ANDROID_APPS = {
  "mosimo" => { dir: ".", module: "app", package: "dev.jisaku.mosimo" },
  "hanashi" => { dir: "../messenger", module: "app", package: "dev.jisaku.hanashi", tests: [":mosimo-dm:test"] }
}.freeze

def android_app!(options)
  ANDROID_APPS.fetch(options[:app].to_s) { UI.user_error!("Unknown app: #{options[:app]}. Choose: #{ANDROID_APPS.keys.join(', ')}") }
end

platform :android do
  desc "Run unit tests, lint, and build a debug APK for the selected app"
  lane :ci do |options|
    app = android_app!(options)
    m = app[:module]
    gradle(project_dir: app[:dir], tasks: [":dtn7-bpv7:test", ":bundle-core:test", ":mesh-android:testDebugUnitTest", *app[:tests],
                                           ":#{m}:testDebugUnitTest", ":#{m}:lintDebug", ":#{m}:assembleDebug"])
  end

  desc "Build a signed release AAB using the Gradle version"
  lane :build do |options|
    app = android_app!(options)
    gradle(project_dir: app[:dir], task: ":#{app[:module]}:bundleRelease")
  end

  desc "Test, build, and publish the AAB and screenshots to the Google Play alpha track"
  # Named internal because mise's deploy task calls it.
  lane :internal do |options|
    app = android_app!(options)
    ci(options)
    build(options)
    # ci leaves the debug APK in lane_context; upload only the AAB.
    # ponytail: metadata defaults to ./fastlane/metadata/android, which only Mosimo's CI screengrab creates; a local hanashi
    # deploy after a screengrab would upload Mosimo's screenshots. Pass a per-app metadata_path once Hanashi has a listing.
    upload_to_play_store(package_name: app[:package], track: "alpha", skip_upload_apk: true)
  end
end
