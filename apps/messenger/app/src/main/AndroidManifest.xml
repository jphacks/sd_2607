<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Mosimo Bosai, so the relay screen can open the app holding this phone's radios. -->
    <queries>
        <package android:name="dev.jisaku.mosimo" />
        <package android:name="dev.jisaku.mosimo.debug" />
    </queries>
    <application
        android:name=".HanashiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Ahead of other Mosimo apps at boot: the first app to start holds the phone's radios (mesh §4.6). -->
        <receiver android:name="org.mndt.mesh.BootReceiver" android:exported="false" tools:node="replace">
            <intent-filter android:priority="999"><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
