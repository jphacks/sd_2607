.DS_Store

apps/android/**/__pycache__/

# Android release credentials and generated Fastlane files
*.jks
*.keystore
**/key.properties
apps/android/fastlane/credentials/
apps/android/.env*
apps/android/fastlane/.env*
apps/android/fastlane/report.xml
apps/android/fastlane/README.md
apps/android/fastlane/Preview.html
apps/android/fastlane/test_output/
apps/android/fastlane/metadata/android/screenshots.html
apps/android/fastlane/metadata/android/*/images/phoneScreenshots/
apps/android/.bundle/
apps/android/vendor/bundle/

# ESP32 development
apps/esp32/.venv/
apps/esp32/**/__pycache__/
apps/esp32/.pio/
apps/esp32/.platformio/
# Locally acquired proprietary evaluation SDK, dictionary, and generated firmware
apps/esp32/private/

# graphify
graphify-out

# Offline issuance material (identity-cli.mjs): root/CA/importer secrets and exports
appview/bsaf/private/
