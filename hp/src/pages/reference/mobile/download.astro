---
import Layout from "../../../layouts/Layout.astro";

const appStore = "https://apps.apple.com/jp/app/id6831930307";
const googlePlay = "https://play.google.com/store/apps/details?id=dev.jisaku.mosimo";
---

<Layout
  title="もしもの防災をダウンロード"
  image="/images/mosimo-bosai-feature.png"
  imageAlt="もしもの防災"
  description="iPhone・iPad 版は App Store、Android 版は Google Play から「もしもの防災」をダウンロードできます。"
>
  <script is:inline define:vars={{ appStore, googlePlay }}>
    // Anything else (PC, unknown UA, JavaScript off) stays here and sees both links.
    const ua = navigator.userAgent;
    // iPadOS reports itself as a Mac, so tell it apart by touch.
    if (/iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)) location.replace(appStore);
    else if (/Android/.test(ua)) location.replace(googlePlay);
  </script>

  <main class="dl-page">
    <section class="dl-hero" aria-labelledby="dl-title">
      <div class="dl-inner">
        <p class="dl-eyebrow">MOSIMO PROTOCOL / DOWNLOAD</p>
        <div class="dl-title">
          <img src="/images/mosimo-bosai-icon.png" width="512" height="512" alt="" />
          <h1 id="dl-title">もしもの防災</h1>
        </div>
        <p class="dl-lead">
          お使いの端末に合ったストアへ移動します。移動しない場合は、下のボタンからダウンロードしてください。
        </p>
        <ul class="dl-stores">
          <li>
            <a class="dl-button" href={appStore}>
              <small>iPhone・iPad</small>
              App Store <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="dl-button" href={googlePlay}>
              <small>Android</small>
              Google Play <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
        <a class="dl-more" href="/reference/mobile/">アプリについて詳しく <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Layout>

<style lang="scss">
  .dl-page {
    color: #171717;
    font-family: system-ui, sans-serif;
    line-height: 1.75;
  }

  .dl-hero {
    background: #ffd600;
    border-bottom: 3px solid #171717;
  }

  .dl-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .dl-eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .dl-title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .dl-title img {
    width: clamp(4rem, 8vw, 6rem);
    flex: none;
    height: auto;
    border: 2px solid #171717;
  }
  .dl-page h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .dl-lead {
    max-width: 35rem;
    margin: 2rem 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .dl-stores {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dl-button {
    display: block;
    padding: 1rem 1.3rem;
    border: 3px solid #171717;
    background: #fff;
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1.3;
    text-decoration: none;
    box-shadow: 6px 6px 0 #171717;
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .dl-button small {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .dl-button:hover {
    transform: translate(3px, 3px);
    box-shadow: 3px 3px 0 #171717;
  }
  .dl-button:focus-visible {
    outline: 3px solid #171717;
    outline-offset: 6px;
  }

  .dl-more {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .dl-inner {
      padding: 4rem 1.25rem;
    }
    .dl-stores {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dl-button {
      transition: none;
    }
  }
</style>
