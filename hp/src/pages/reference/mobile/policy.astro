---
import Layout from "../../../layouts/Layout.astro";
import { Content } from "../../../content/policy.md";
---

<Layout title="「もしもの防災」プライバシーポリシー">
  <main class="policy">
    <Content />
  </main>
</Layout>

<style lang="scss">
  .policy {
    max-width: 850px;
    margin: auto;
    padding: 5rem 1.5rem 7rem;
    line-height: 1.9;
  }
  .policy :global(h1) {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.3;
    border-bottom: 3px solid;
    padding-bottom: 1.5rem;
  }
  .policy :global(h2) {
    font-size: 1.35rem;
    margin-top: 3rem;
    border-bottom: 1px solid;
    padding-bottom: 0.5rem;
  }
  .policy :global(a) {
    overflow-wrap: anywhere;
  }
</style>
