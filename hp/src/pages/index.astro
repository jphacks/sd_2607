<script>
  // チャプターのリンクは、JavaScript が使えればページ内の動画をその位置から再生する。
  const player = document.querySelector<HTMLIFrameElement>("#home-talk-video");
  document.querySelectorAll<HTMLAnchorElement>(".home-chapters a").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (!player) return;
      event.preventDefault();
      const url = new URL(player.src);
      url.searchParams.set("start", link.dataset.start ?? "0");
      url.searchParams.set("autoplay", "1");
      player.src = url.href;
      player.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });
</script>

