---
import Layout from "../layouts/Layout.astro";
import { brandIcons, type BrandIcon } from "../data/award-icons";

// 「なぜプロトコルか」の図。同じ40人のうち、Bluetooth などで中継に参加できる人を塗る。
const people = Array.from({ length: 40 }, (_, i) => i);
const dedicated = new Set([6, 19, 33]);
// 対応アプリが3種類（A・B・C）あり、それぞれの利用者が混在している想定。
const protocolApp = (i: number) => ((i * 7) % 10 < 7 ? ["a", "b", "c"][i % 3] : null);

const youtubeMain = "piaNsc6ilBI";
const youtubeTalk = "nQAZIvaILJc";
const embed = (id: string, start = 0) =>
  `https://www.youtube-nocookie.com/embed/${id}?rel=0${start ? `&start=${start}` : ""}`;
const chapters = [
  { start: 0, time: "0:00", label: "概要プレゼンテーション" },
  { start: 239, time: "3:59", label: "実機デモ" },
  { start: 395, time: "6:35", label: "技術構成解説" },
];

// brand がない賞（オーディエンス賞）にはトロフィーを表示する。
type Award = {
  name: string;
  kind: string;
  parts?: string[];
  brand?: BrandIcon;
  featured?: boolean;
};
const awardDay: Award[] = [
  { name: "Best Audience Award", kind: "オーディエンス賞", featured: true },
  { name: "Bluesky賞", kind: "企業賞", brand: brandIcons.bluesky },
  { name: "Huawei賞", kind: "企業賞", brand: brandIcons.huawei },
  { name: "SoftBank賞", kind: "企業賞", brand: brandIcons.softbank },
];
const hackDay: Award[] = [
  { name: "Audience Award", kind: "オーディエンス賞" },
  {
    name: "三菱重工業株式会社 航空機・飛昇体事業部賞",
    parts: ["三菱重工業株式会社", "航空機・飛昇体事業部賞"],
    kind: "企業賞",
    brand: brandIcons.mitsubishi,
  },
];
const awards = [
  { stage: "Award Day", note: "決勝", list: awardDay },
  { stage: "Hack Day", note: "仙台会場", list: hackDay },
];
const awardCount = awardDay.length + hackDay.length;
---

<Layout
  title="Mosimo Protocol"
  description="いつものアプリを、もしもの通信網に。圏外でも端末同士で情報をつなぐ、災害時のための共通プロトコル。"
>
  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-wrap home-hero-grid">
        <div class="home-hero-copy">
          <p class="home-kicker">
            <span class="home-dot"></span> FOR WHEN CONNECTION FAILS
          </p>
          <h1 id="home-title">
            いつもの<wbr />アプリが、
            <br />
            <span>もしもの<wbr />通信網に<wbr />なる。</span>
          </h1>

          <p class="home-hero-text">
            災害でインターネットが使えない。そんな時も、近くの端末から端末へ。Mosimo
            Protocolは、情報をつなぐための共通プロトコルです。
          </p>
          <div class="home-actions">
            <a class="home-button home-button-primary" href="#what">
              しくみを知る <span aria-hidden="true">↘</span>
            </a>
            <a class="home-button home-button-ghost" href="#video">
              動画で見る <span aria-hidden="true">▶</span>
            </a>
          </div>
          <a class="home-hero-award" href="#awards">
            <span class="home-hero-award-mark" aria-hidden="true">★</span>
            <span>JPHACKS 2026 で{awardCount}つの賞を受賞しました</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div
          class="home-signal"
          role="img"
          aria-label="圏外の端末から中継を経てオンラインへ情報を届けるイメージ"
        >
          <div class="home-signal-top">
            <span>CONNECTION STATUS</span>
            <span>01 / MOSIMO</span>
          </div>
          <div class="home-signal-title">
            NO SIGNAL<span>_</span>
          </div>
          <p>端末同士で情報を中継</p>
          <div class="home-route" aria-hidden="true">
            <div class="home-node">
              <span>01</span>
              <strong>発信</strong>
              <small>OFFLINE</small>
            </div>
            <div class="home-route-line">→</div>
            <div class="home-node home-node-yellow">
              <span>02</span>
              <strong>中継</strong>
              <small>RELAY</small>
            </div>
            <div class="home-route-line">→</div>
            <div class="home-node">
              <span>03</span>
              <strong>公開</strong>
              <small>ONLINE</small>
            </div>
          </div>
          <div class="home-signal-bottom">
            <span>STORE / CARRY / FORWARD</span>
            <span>↗</span>
          </div>
        </div>
      </div>
      <div class="home-ticker" aria-hidden="true">
        <span>WHEN NETWORKS STOP</span>
        <span>✳</span>
        <span>PEOPLE CAN STILL CONNECT</span>
        <span>✳</span>
        <span>MOSIMO PROTOCOL</span>
        <span>✳</span>
        <span>WHEN NETWORKS STOP</span>
      </div>
    </section>

    <section
      class="home-problem home-section"
      aria-labelledby="home-problem-title"
    >
      <div class="home-wrap home-split">
        <div>
          <p class="home-label">01 / THE PROBLEM</p>
          <h2 id="home-problem-title">
            災害時、
            <br />
            <span>通信が途絶えると</span>
          </h2>
        </div>
        <div class="home-problem-copy">
          <p class="home-large">
            避難所の状況や、
            <br />
            地域の情報が届かない。
          </p>
          <p>
            大きな災害では、基地局の故障や停電で、スマートフォンが圏外になることがあります。家族の安否、避難所で足りない物資、通れない道。いちばん情報が必要なときに、それを伝える手段がなくなってしまいます。
          </p>
          <p>
            スマートフォン同士がBluetoothなどで直接つながる技術はすでにあります。でも、そのための専用アプリを、災害が起きる前から入れている人はほとんどいません。圏外になってから入れることもできません。それが、もしもの時の壁です。
          </p>
          <p>
            だから私たちは、日常使うアプリが、非常時には情報を運ぶ一端を担う未来を考えました。
          </p>
        </div>
      </div>
    </section>

    <section
      class="home-what home-section"
      id="what"
      aria-labelledby="home-what-title"
    >
      <div class="home-wrap">
        <div class="home-split">
          <div>
            <p class="home-label">02 / WHAT IS A PROTOCOL</p>
            <h2 id="home-what-title">
              プロトコルって、
              <br />
              なに？
            </h2>
          </div>
          <div class="home-what-copy">
            <p class="home-large">
              違うもの同士が話すための、
              <br />
              共通の約束ごとです。
            </p>
            <p>
              プロトコルとは、データをどんな形で、どんな手順でやりとりするかを決めたルールのことです。ルールさえ同じなら、作った会社やアプリが違っても、お互いの言葉が通じます。じつは私たちは、毎日プロトコルの恩恵を受けています。
            </p>
          </div>
        </div>

        <ul class="home-analogies">
          <li>
            <span class="home-analogy-icon" aria-hidden="true">✉</span>
            <h3>メール</h3>
            <p>
              GmailからiPhoneのメールアプリへ。サービスが違ってもメールが届くのは、メールの送り方を決めたプロトコルが共通だからです。
            </p>
          </li>
          <li>
            <span class="home-analogy-icon" aria-hidden="true">☎</span>
            <h3>電話</h3>
            <p>
              携帯電話の会社が違っても、番号を押せば相手につながります。会社をまたいでつなぐ方法が、あらかじめ決められているからです。
            </p>
          </li>
          <li class="home-analogy-mosimo">
            <span class="home-analogy-icon" aria-hidden="true">✳</span>
            <h3>Mosimo Protocol</h3>
            <p>
              アプリが違っても、圏外でも、災害時の投稿をスマートフォン同士で受け渡せる。そのための約束ごとを決めたのが、Mosimo Protocolです。
            </p>
          </li>
        </ul>

        <div class="home-defines">
          <h3>Mosimo Protocolが決めていること</h3>
          <dl>
            <div>
              <dt>投稿の形</dt>
              <dd>
                本文・場所・有効期間など、災害時の情報をどんな形で書き表すか。どのアプリが読んでも同じ意味になるように決めています。
              </dd>
            </div>
            <div>
              <dt>端末同士の受け渡し方</dt>
              <dd>
                BluetoothやWi-Fiで近くの端末を見つけ、相手がまだ持っていない投稿だけを効率よく交換する手順です。
              </dd>
            </div>
            <div>
              <dt>書いた人の証明</dt>
              <dd>
                投稿には電子署名を付けます。何人の手を経て運ばれても、誰の鍵で書かれたか、途中で書き換えられていないかを確かめられます。
              </dd>
            </div>
            <div>
              <dt>インターネットへの届け方</dt>
              <dd>
                電波の届く場所に来た端末が、運んできた投稿をインターネット上のサーバーへ渡す方法です。遠くの家族や支援者もWebで読めるようになります。
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="home-why home-section" aria-labelledby="home-why-title">
      <div class="home-wrap">
        <div class="home-section-head">
          <div>
            <p class="home-label">03 / WHY A PROTOCOL</p>
            <h2 id="home-why-title">
              なぜ、アプリではなく
              <br />
              プロトコルなのか
            </h2>
          </div>
          <p>
            端末から端末へ情報を運ぶには、
            <br />
            近くに「仲間」がいることが必要です。
          </p>
        </div>

        <div class="home-compare">
          <figure class="home-compare-panel">
            <figcaption>
              <span class="home-compare-tag">専用アプリだけの場合</span>
              <strong>近くに仲間がほとんどいない</strong>
            </figcaption>
            <div
              class="home-people"
              role="img"
              aria-label="40人のうち、専用アプリを入れている3人だけが中継に参加できる図"
            >
              {
                people.map((i) => (
                  <span class:list={["home-person", dedicated.has(i) && "is-a"]} />
                ))
              }
            </div>
            <p>
              災害のために専用アプリを入れている人はわずかです。隣の人に届けようにも、相手がアプリを持っていなければ情報は止まってしまいます。
            </p>
          </figure>
          <figure class="home-compare-panel home-compare-panel-yes">
            <figcaption>
              <span class="home-compare-tag">共通のプロトコルの場合</span>
              <strong>いつものアプリが、<wbr />みんな<wbr />仲間になる</strong>
            </figcaption>
            <div
              class="home-people"
              role="img"
              aria-label="40人のうち、異なる3種類の対応アプリを使う多くの人が、互いに中継に参加できる図"
            >
              {
                people.map((i) => {
                  const app = protocolApp(i);
                  return <span class:list={["home-person", app && `is-${app}`]} />;
                })
              }
            </div>
            <ul class="home-legend" aria-hidden="true">
              <li><span class="home-person is-a"></span>アプリA</li>
              <li><span class="home-person is-b"></span>アプリB</li>
              <li><span class="home-person is-c"></span>アプリC</li>
            </ul>
            <p>
              地域のアプリ、学校のアプリ、SNS。違うアプリでも同じ約束ごとを話せれば、互いに情報を中継できます。
            </p>
          </figure>
        </div>
        <p class="home-note">
          ※ 図はイメージです。導入率による違いは<a href="/reference/simulator/">もしもシミュレーター</a>で試せます。
        </p>

        <ol class="home-reasons">
          <li>
            <span>01</span>
            <h3>事前の準備がいらない</h3>
            <p>
              普段使っているアプリが対応していれば、それだけで備えになります。災害用のアプリを探して入れておく必要はありません。
            </p>
          </li>
          <li>
            <span>02</span>
            <h3>つながる相手が増える</h3>
            <p>
              中継は、近くに対応した端末がいて初めて成り立ちます。アプリの垣根をなくすことで、つながる相手の数を大きく増やせます。
            </p>
          </li>
          <li>
            <span>03</span>
            <h3>特定の会社に頼らない</h3>
            <p>
              仕様は公開されていて、誰でも自分のアプリに組み込めます。ひとつのサービスが止まっても、仕組みそのものは止まりません。
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section
      class="home-how home-section"
      id="how"
      aria-labelledby="home-how-title"
    >
      <div class="home-wrap">
        <div class="home-section-head">
          <div>
            <p class="home-label">04 / HOW IT WORKS</p>
            <h2 id="home-how-title">
              端末から端末へ
              <br />
              情報を運ぶ
            </h2>
          </div>
          <p>
            インターネットが使えなくても、
            <br />
            近くにいる人との接点が道になる。
          </p>
        </div>
        <div class="home-cards">
          <article class="home-card">
            <div class="home-card-top">
              <span>STEP 01</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>
              近くの端末と
              <br />
              情報を交換
            </h3>
            <p>
              BluetoothやWi-Fiを使い、対応する端末同士で投稿を受け渡します。インターネットも基地局も使いません。
            </p>
            <div class="home-card-tag">OFFLINE</div>
          </article>
          <article class="home-card home-card-yellow">
            <div class="home-card-top">
              <span>STEP 02</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>
              人と一緒に
              <br />
              情報も移動
            </h3>
            <p>
              受け取った情報を端末に保存し、別の端末へ中継。避難所へ歩く人、物資を運ぶ車と一緒に、情報も少しずつ遠くへ運ばれます。
            </p>
            <div class="home-card-tag">RELAY</div>
          </article>
          <article class="home-card">
            <div class="home-card-top">
              <span>STEP 03</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>
              オンラインへ
              <br />
              つなぐ
            </h3>
            <p>
              電波の届く場所に着いた端末が投稿を公開。離れた場所からもWebクライアントで閲覧できます。
            </p>
            <div class="home-card-tag">ONLINE</div>
          </article>
        </div>
        <p class="home-note">
          ※
          情報の中継には、近くに対応する端末があることなど、通信できる条件が必要です。
        </p>
      </div>
    </section>

    <section
      class="home-video home-section"
      id="video"
      aria-labelledby="home-video-title"
    >
      <div class="home-wrap">
        <div class="home-section-head">
          <div>
            <p class="home-label">05 / WATCH</p>
            <h2 id="home-video-title">動画で見る</h2>
          </div>
          <p>
            しくみと実機での動作を、
            <br />
            動画で紹介しています。
          </p>
        </div>
        <div class="home-videos">
          <figure class="home-video-item">
            <div class="home-video-frame">
              <iframe
                src={embed(youtubeMain)}
                title="Mosimo Protocol 紹介動画（YouTube）"
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen></iframe>
            </div>
            <figcaption>
              <strong>紹介動画</strong>
              <span>いつものアプリが、もしもの通信網になる。</span>
            </figcaption>
          </figure>
          <figure class="home-video-item">
            <div class="home-video-frame">
              <iframe
                id="home-talk-video"
                src={embed(youtubeTalk)}
                title="JPHACKS 2026 発表とデモ（YouTube）"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen></iframe>
            </div>
            <figcaption>
              <strong>JPHACKS 2026 発表とデモ</strong>
              <span>見たいところから再生できます。</span>
            </figcaption>
            <ul class="home-chapters">
              {
                chapters.map((c) => (
                  <li>
                    <a
                      href={`https://youtu.be/${youtubeTalk}?t=${c.start}`}
                      data-start={c.start}
                    >
                      <span>{c.time}</span>
                      {c.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </figure>
        </div>
      </div>
    </section>

    <section
      class="home-features home-section"
      aria-labelledby="home-features-title"
    >
      <div class="home-wrap home-split">
        <div>
          <p class="home-label">06 / BUILT FOR CONNECTION</p>
          <h2 id="home-features-title">
            ひとつのアプリに
            <br />
            閉じない。
          </h2>
          <p class="home-feature-intro">
            異なるアプリが、同じ情報の道を使えるように。もしもの備えを、日常の中へ。
          </p>
        </div>
        <div class="home-feature-list">
          <article>
            <span>01</span>
            <div>
              <h3>アプリを越える<wbr />共通の土台</h3>
              <p>
                対応する異なるアプリ間で情報を交換できる設計。用途に応じて情報を拡張し、未対応の拡張も壊さず中継できます。仕様は<a href="/protocol/">プロトコル仕様</a>として公開しています。
              </p>
            </div>
          </article>
          <article>
            <span>02</span>
            <div>
              <h3>署名を保って、<wbr />情報を運ぶ</h3>
              <p>
                投稿者の署名を保ちながら中継し、発信元の検証につなげます。署名は投稿内容の真偽を保証するものではありません。
              </p>
            </div>
          </article>
          <article>
            <span>03</span>
            <div>
              <h3>既存のネットワークともつながる</h3>
              <p>
                インターネット側では、BlueskyのAT ProtocolやNostrといった分散型SNSの仕組みを使って投稿を公開・保存します。特定のサーバーが止まっても、情報が失われにくい構成です。
              </p>
            </div>
          </article>
          <article>
            <span>04</span>
            <div>
              <h3>アプリとして、すぐに使える</h3>
              <p>
                iPhone・iPad・Android 用アプリ「<a href="/reference/mobile">もしもの防災</a>」として配信しています。ESP32の中継機器、サーバー、Webクライアントとあわせて、投稿から公開までを実装しています。
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section
      class="home-awards home-section"
      id="awards"
      aria-labelledby="home-awards-title"
    >
      <div class="home-wrap">
        <div class="home-section-head">
          <div>
            <p class="home-label">07 / AWARDS</p>
            <h2 id="home-awards-title">
              JPHACKS 2026で
              <br />
              <span>{awardCount}つの賞</span>を受賞
            </h2>
          </div>
          <p>
            Team JISAKUとして出場し、
            <br />
            Hack DayとAward Dayで評価をいただきました。
          </p>
        </div>

        {
          awards.map(({ stage, note, list }) => (
            <div class="home-award-stage">
              <div class="home-award-stage-head">
                <h3>{stage}</h3>
                <span>
                  {note}・{list.length}賞
                </span>
              </div>
              <ul class:list={["home-award-list", list.length === 2 && "home-award-list-two"]}>
                {list.map((a) => (
                  <li class:list={["home-award", a.featured && "home-award-featured"]}>
                    <div class="home-award-top">
                      {a.brand ? (
                        <span class="home-award-icon home-award-icon-brand" title={a.brand.title}>
                          <svg viewBox="0 0 24 24" aria-hidden="true" fill={a.brand.color}>
                            <path d={a.brand.path} />
                          </svg>
                        </span>
                      ) : (
                        <span class="home-award-icon home-award-icon-trophy">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 3h10v2h3v3a4 4 0 0 1-4 4h-.3A5 5 0 0 1 13 14.9V17h3v2H8v-2h3v-2.1A5 5 0 0 1 8.3 12H8a4 4 0 0 1-4-4V5h3zm0 4H6v1a2 2 0 0 0 1 1.7zm10 0v2.7A2 2 0 0 0 18 8V7zM7 20h10v2H7z" />
                          </svg>
                        </span>
                      )}
