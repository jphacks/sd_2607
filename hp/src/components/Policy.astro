---
import Layout from "../layouts/Layout.astro";
import { Content } from "../content/policy.md";

interface Props {
  appName: string;
  image?: string;
  imageAlt?: string;
}

const { appName, image, imageAlt } = Astro.props;
const title = `「${appName}」プライバシーポリシー`;
---

<Layout title={title} description={`「${appName}」における情報の取り扱いについて。`} image={image} imageAlt={imageAlt}>
  <main class="policy">
    <h1>{title}</h1>
    <p>制定日：2026年11月2日</p>
    <p>
      Team JISAKU（以下「本団体」）は、本団体が提供するアプリ「{appName}」（以下「本アプリ」）における情報の取り扱いについて、以下のとおり定めます。
    </p>
    <Content />
  </main>
</Layout>

<style lang="scss">
  .policy {
    max-width: 850px;
    margin: auto;
    padding: 5rem 1.5rem 7rem;
    line-height: 1.9;
  }
  .policy :global(h1) {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.3;
    border-bottom: 3px solid;
    padding-bottom: 1.5rem;
  }
  .policy :global(h2) {
    font-size: 1.35rem;
    margin-top: 3rem;
    border-bottom: 1px solid;
    padding-bottom: 0.5rem;
  }
  .policy :global(a) {
    overflow-wrap: anywhere;
  }
</style>
