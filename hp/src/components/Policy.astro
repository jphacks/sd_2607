---
import LegalDocument from "./LegalDocument.astro";
import { Content } from "../content/policy.md";

interface Props {
  appName: string;
  /** 制定日。アプリごとに異なる */
  enacted: string;
  image?: string;
  imageAlt?: string;
}

// 本文（第1条以降）と最終改定日は全アプリ共通。アプリ内の同じ文面と揃える。
const revised = "2026年11月13日";
const { appName, enacted, image, imageAlt } = Astro.props;
---

<LegalDocument title={`「${appName}」プライバシーポリシー`} description={`「${appName}」における利用者の情報の取扱いについて。`}
  enacted={enacted} revised={revised} image={image} imageAlt={imageAlt}>
  <p>
    Team JISAKU（以下「当団体」といいます。）は、当団体が提供するアプリケーション「{appName}」（以下「本アプリ」といいます。）における利用者の情報の取扱いについて、以下のとおりプライバシーポリシー（以下「本ポリシー」といいます。）を定めます。
  </p>
  <Content />
</LegalDocument>
