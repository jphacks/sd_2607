---
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  enacted: string;
  revised: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, enacted, revised, image, imageAlt } = Astro.props;
---

<Layout title={title} description={description} image={image} imageAlt={imageAlt}>
  <main class="policy">
    <h1>{title}</h1>
    <p>制定日：{enacted}<br />最終改定日：{revised}</p>
    <slot />
  </main>
</Layout>

<style lang="scss">
  .policy {
    max-width: 850px;
    margin: auto;
    padding: 5rem 1.5rem 7rem;
    line-height: 1.9;
  }
  .policy :global(h1) {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.3;
    border-bottom: 3px solid;
    padding-bottom: 1.5rem;
  }
  .policy :global(h2) {
    font-size: 1.35rem;
    margin-top: 3rem;
    border-bottom: 1px solid;
    padding-bottom: 0.5rem;
  }
  .policy :global(a) {
    overflow-wrap: anywhere;
  }
</style>
