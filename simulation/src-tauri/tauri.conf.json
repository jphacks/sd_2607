{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "もしもシミュレーター",
  "version": "0.1.0",
  "identifier": "dev.jisaku.mosimo.simulation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "もしもシミュレーター",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cyberjapandata.gsi.go.jp; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "ja-JP",
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      },
      "nsis": {
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["Japanese"]
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
